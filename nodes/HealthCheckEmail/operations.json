[
  {
    "name": "add_domain",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    },
    "description": "Add a domain to HealthCheckEmail monitoring. Returns its DMARC reporting address and the exact suggested DNS record.",
    "inputSchema": {
      "type": "object",
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "description": "A root domain such as example.com"
        }
      }
    }
  },
  {
    "name": "create_alert",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    },
    "description": "Create an email, HTTPS webhook, or Slack alert for email-health events. Generic webhooks return a signing secret.",
    "inputSchema": {
      "type": "object",
      "required": [
        "domainId",
        "channel",
        "target"
      ],
      "properties": {
        "domainId": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "enum": [
            "email",
            "webhook",
            "slack"
          ]
        },
        "target": {
          "type": "string",
          "description": "Email address or HTTPS webhook URL"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "dns_change",
              "dmarc_multi",
              "spike",
              "dkim_weak_key"
            ]
          },
          "minItems": 1
        }
      }
    }
  },
  {
    "name": "delete_alert",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    },
    "description": "Permanently delete an alert from a monitored domain.",
    "inputSchema": {
      "type": "object",
      "required": [
        "domainId",
        "alertId"
      ],
      "properties": {
        "domainId": {
          "type": "string"
        },
        "alertId": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "disable_public_status",
    "annotations": {
      "readOnlyHint": false,
